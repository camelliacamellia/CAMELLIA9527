name: "UNet"

# 输入层（部署时使用）
input: "data"
input_dim: 1    # batch size
input_dim: 1    # channels (灰度图)
input_dim: 572  # height
input_dim: 572  # width

# ==================== 编码器路径（下采样）====================

# 第1层编码器块
layer {
  name: "conv1_1"
  type: "Convolution"
  bottom: "data"
  top: "conv1_1"
  convolution_param {
    num_output: 64
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu1_1"
  type: "ReLU"
  bottom: "conv1_1"
  top: "conv1_1"
}

layer {
  name: "conv1_2"
  type: "Convolution"
  bottom: "conv1_1"
  top: "conv1_2"
  convolution_param {
    num_output: 64
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu1_2"
  type: "ReLU"
  bottom: "conv1_2"
  top: "conv1_2"
}

layer {
  name: "pool1"
  type: "Pooling"
  bottom: "conv1_2"
  top: "pool1"
  pooling_param {
    pool: MAX
    kernel_size: 2
    stride: 2
  }
}

# 第2层编码器块
layer {
  name: "conv2_1"
  type: "Convolution"
  bottom: "pool1"
  top: "conv2_1"
  convolution_param {
    num_output: 128
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu2_1"
  type: "ReLU"
  bottom: "conv2_1"
  top: "conv2_1"
}

layer {
  name: "conv2_2"
  type: "Convolution"
  bottom: "conv2_1"
  top: "conv2_2"
  convolution_param {
    num_output: 128
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu2_2"
  type: "ReLU"
  bottom: "conv2_2"
  top: "conv2_2"
}

layer {
  name: "pool2"
  type: "Pooling"
  bottom: "conv2_2"
  top: "pool2"
  pooling_param {
    pool: MAX
    kernel_size: 2
    stride: 2
  }
}

# 第3层编码器块
layer {
  name: "conv3_1"
  type: "Convolution"
  bottom: "pool2"
  top: "conv3_1"
  convolution_param {
    num_output: 256
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu3_1"
  type: "ReLU"
  bottom: "conv3_1"
  top: "conv3_1"
}

layer {
  name: "conv3_2"
  type: "Convolution"
  bottom: "conv3_1"
  top: "conv3_2"
  convolution_param {
    num_output: 256
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu3_2"
  type: "ReLU"
  bottom: "conv3_2"
  top: "conv3_2"
}

layer {
  name: "pool3"
  type: "Pooling"
  bottom: "conv3_2"
  top: "pool3"
  pooling_param {
    pool: MAX
    kernel_size: 2
    stride: 2
  }
}

# 第4层编码器块
layer {
  name: "conv4_1"
  type: "Convolution"
  bottom: "pool3"
  top: "conv4_1"
  convolution_param {
    num_output: 512
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu4_1"
  type: "ReLU"
  bottom: "conv4_1"
  top: "conv4_1"
}

layer {
  name: "conv4_2"
  type: "Convolution"
  bottom: "conv4_1"
  top: "conv4_2"
  convolution_param {
    num_output: 512
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu4_2"
  type: "ReLU"
  bottom: "conv4_2"
  top: "conv4_2"
}

layer {
  name: "pool4"
  type: "Pooling"
  bottom: "conv4_2"
  top: "pool4"
  pooling_param {
    pool: MAX
    kernel_size: 2
    stride: 2
  }
}

# ==================== 瓶颈层 ====================
layer {
  name: "conv5_1"
  type: "Convolution"
  bottom: "pool4"
  top: "conv5_1"
  convolution_param {
    num_output: 1024
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu5_1"
  type: "ReLU"
  bottom: "conv5_1"
  top: "conv5_1"
}

layer {
  name: "conv5_2"
  type: "Convolution"
  bottom: "conv5_1"
  top: "conv5_2"
  convolution_param {
    num_output: 1024
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu5_2"
  type: "ReLU"
  bottom: "conv5_2"
  top: "conv5_2"
}

# ==================== 解码器路径（上采样）====================

# 第1层解码器块
layer {
  name: "upconv1"
  type: "Deconvolution"
  bottom: "conv5_2"
  top: "upconv1"
  convolution_param {
    num_output: 512
    kernel_size: 2
    stride: 2
  }
}

layer {
  name: "crop1"
  type: "Crop"
  bottom: "conv4_2"
  bottom: "upconv1"
  top: "crop1"
  crop_param {
    axis: 2
    offset: 4
  }
}

layer {
  name: "concat1"
  type: "Concat"
  bottom: "upconv1"
  bottom: "crop1"
  top: "concat1"
  concat_param {
    axis: 1
  }
}

layer {
  name: "conv6_1"
  type: "Convolution"
  bottom: "concat1"
  top: "conv6_1"
  convolution_param {
    num_output: 512
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu6_1"
  type: "ReLU"
  bottom: "conv6_1"
  top: "conv6_1"
}

layer {
  name: "conv6_2"
  type: "Convolution"
  bottom: "conv6_1"
  top: "conv6_2"
  convolution_param {
    num_output: 512
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu6_2"
  type: "ReLU"
  bottom: "conv6_2"
  top: "conv6_2"
}

# 第2层解码器块
layer {
  name: "upconv2"
  type: "Deconvolution"
  bottom: "conv6_2"
  top: "upconv2"
  convolution_param {
    num_output: 256
    kernel_size: 2
    stride: 2
  }
}

layer {
  name: "crop2"
  type: "Crop"
  bottom: "conv3_2"
  bottom: "upconv2"
  top: "crop2"
  crop_param {
    axis: 2
    offset: 16
  }
}

layer {
  name: "concat2"
  type: "Concat"
  bottom: "upconv2"
  bottom: "crop2"
  top: "concat2"
  concat_param {
    axis: 1
  }
}

layer {
  name: "conv7_1"
  type: "Convolution"
  bottom: "concat2"
  top: "conv7_1"
  convolution_param {
    num_output: 256
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu7_1"
  type: "ReLU"
  bottom: "conv7_1"
  top: "conv7_1"
}

layer {
  name: "conv7_2"
  type: "Convolution"
  bottom: "conv7_1"
  top: "conv7_2"
  convolution_param {
    num_output: 256
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu7_2"
  type: "ReLU"
  bottom: "conv7_2"
  top: "conv7_2"
}

# 第3层解码器块
layer {
  name: "upconv3"
  type: "Deconvolution"
  bottom: "conv7_2"
  top: "upconv3"
  convolution_param {
    num_output: 128
    kernel_size: 2
    stride: 2
  }
}

layer {
  name: "crop3"
  type: "Crop"
  bottom: "conv2_2"
  bottom: "upconv3"
  top: "crop3"
  crop_param {
    axis: 2
    offset: 40
  }
}

layer {
  name: "concat3"
  type: "Concat"
  bottom: "upconv3"
  bottom: "crop3"
  top: "concat3"
  concat_param {
    axis: 1
  }
}

layer {
  name: "conv8_1"
  type: "Convolution"
  bottom: "concat3"
  top: "conv8_1"
  convolution_param {
    num_output: 128
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu8_1"
  type: "ReLU"
  bottom: "conv8_1"
  top: "conv8_1"
}

layer {
  name: "conv8_2"
  type: "Convolution"
  bottom: "conv8_1"
  top: "conv8_2"
  convolution_param {
    num_output: 128
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu8_2"
  type: "ReLU"
  bottom: "conv8_2"
  top: "conv8_2"
}

# 第4层解码器块
layer {
  name: "upconv4"
  type: "Deconvolution"
  bottom: "conv8_2"
  top: "upconv4"
  convolution_param {
    num_output: 64
    kernel_size: 2
    stride: 2
  }
}

layer {
  name: "crop4"
  type: "Crop"
  bottom: "conv1_2"
  bottom: "upconv4"
  top: "crop4"
  crop_param {
    axis: 2
    offset: 88
  }
}

layer {
  name: "concat4"
  type: "Concat"
  bottom: "upconv4"
  bottom: "crop4"
  top: "concat4"
  concat_param {
    axis: 1
  }
}

layer {
  name: "conv9_1"
  type: "Convolution"
  bottom: "concat4"
  top: "conv9_1"
  convolution_param {
    num_output: 64
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu9_1"
  type: "ReLU"
  bottom: "conv9_1"
  top: "conv9_1"
}

layer {
  name: "conv9_2"
  type: "Convolution"
  bottom: "conv9_1"
  top: "conv9_2"
  convolution_param {
    num_output: 64
    kernel_size: 3
    pad: 0
  }
}

layer {
  name: "relu9_2"
  type: "ReLU"
  bottom: "conv9_2"
  top: "conv9_2"
}

# ==================== 输出层 ====================
layer {
  name: "conv10"
  type: "Convolution"
  bottom: "conv9_2"
  top: "conv10"
  convolution_param {
    num_output: 2  # 二分类，可根据需求修改
    kernel_size: 1
  }
}

layer {
  name: "prob"
  type: "Softmax"
  bottom: "conv10"
  top: "prob"
}